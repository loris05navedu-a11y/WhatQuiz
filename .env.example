# Port HTTP du serveur WhatQuiz (API + application + Socket.IO)
PORT=3000

# Adresse d'écoute. 0.0.0.0 = accessible depuis les autres appareils du réseau local (élèves)
HOST=0.0.0.0

# Chemin du fichier SQLite (créé automatiquement)
DATABASE_PATH=./data/whatquiz.db

# Dossier des images envoyées dans les quiz
UPLOAD_DIR=./data/uploads

# Durée de validité d'une session de connexion (en jours)
SESSION_DAYS=14

# Mettre à true uniquement si l'application est servie en HTTPS (cookie "Secure")
COOKIE_SECURE=false

# Nombre maximum de joueurs par partie
MAX_PLAYERS=100
